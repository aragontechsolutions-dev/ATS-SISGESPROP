{
  "name": "@ats/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PRIVAT – Landing pública prerenderizada (y, en el Bloque D, panel /admin)",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json --noEmit && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --outDir dist/client --host 127.0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@ats/pricing": "0.1.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
