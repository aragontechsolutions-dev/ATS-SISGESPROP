# Variables PÚBLICAS de la web (se incrustan en el JavaScript: nunca poner secretos aquí).
# URL de la API (Render). Sin barra final.
VITE_API_URL=http://127.0.0.1:3000
# Clave de sitio de Cloudflare Turnstile. En desarrollo: clave de prueba de Cloudflare.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# URL pública del sitio (canonical, sitemap, datos estructurados). Sin barra final.
VITE_SITE_URL=http://127.0.0.1:4173
# Panel /admin: Supabase Auth (URL del proyecto y clave PUBLICABLE/anon; nunca la service role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
