# Copiar a .env SOLO en desarrollo local. En Render se cargan como variables de entorno.
# Nunca subir .env al repositorio.

NODE_ENV=development
PORT=3000

# Conexión de la app (Supabase transaction pooler :6543)
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:6543/postgres?pgbouncer=true
# Conexión de migraciones (directa o session pooler :5432). Solo CLI / CI.
DIRECT_URL=postgresql://USUARIO:CLAVE@HOST:5432/postgres

# Proyecto Supabase (URL pública). La API verifica JWT con sus claves públicas (JWKS).
SUPABASE_URL=https://PROYECTO.supabase.co

# Orígenes permitidos (separados por coma, coincidencia exacta)
CORS_ORIGINS=http://localhost:5173

# Secreto para el HMAC de IPs (mínimo 32 caracteres aleatorios). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
IP_HASH_SECRET=

# Saltos de proxy de confianza para obtener la IP real (Render: verificar, valor inicial 1)
TRUST_PROXY_HOPS=1

# Cloudflare Turnstile (anti-spam del formulario). La clave SECRETA vive solo aquí (Render).
TURNSTILE_SECRET_KEY=
# Dominios del sitio desde los que se aceptan tokens (obligatorio en producción). Ej.: www.dominio.com.uy,dominio.com.uy
TURNSTILE_ALLOWED_HOSTNAMES=

# Deploy hook de Vercel (secreto: quien lo conoce puede disparar builds). Opcional.
# "Publicar" en el panel lo llama para regenerar la landing con el contenido publicado.
VERCEL_DEPLOY_HOOK_URL=
